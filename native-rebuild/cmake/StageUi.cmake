cmake_policy(SET CMP0057 NEW)
cmake_path(ABSOLUTE_PATH UI_SOURCE NORMALIZE OUTPUT_VARIABLE ui_source_path)
cmake_path(ABSOLUTE_PATH UI_DESTINATION NORMALIZE OUTPUT_VARIABLE ui_destination_path)
cmake_path(IS_PREFIX ui_source_path "${ui_destination_path}" NORMALIZE destination_inside_source)
if(destination_inside_source)
  message(FATAL_ERROR "UI staging destination must be outside the source tree")
endif()
file(GLOB_RECURSE ui_files RELATIVE "${UI_SOURCE}" "${UI_SOURCE}/*")
set(staged_visualizers)
set(staged_ui_files)
# A former build-time extractor lived at this path; never ship it as page code.
file(REMOVE "${UI_DESTINATION}/extract-reference.mjs")
foreach(relative IN LISTS ui_files)
  if(relative MATCHES "(^|/)(tests|tools)/|\\.test\\.|(^|/)node_modules/|^music-(visualizers|background|effects|material)/(.*/)?(source|src|verification|evidence)/|^music-visualizers/reference/contracts\\.js$")
    continue()
  endif()
  if(NOT relative MATCHES "\\.(html|css|js|mjs|png|jpg|jpeg|svg|webp|ttf|otf|woff|woff2)$" AND NOT relative MATCHES "^assets/sources/.*\\.md$" AND NOT relative MATCHES "^assets/music/(SOURCES\\.md|lucide-LICENSE\\.txt)$" AND NOT relative MATCHES "^vendor/notes-(math|editor)/.*\\.(txt|md|json)$" AND NOT relative MATCHES "^music-(visualizers|background|effects|material|provider-qr)/.*\\.(txt|md|json)$" AND NOT relative MATCHES "^music-(visualizers|background|effects|material)/.*/licenses/.*(LICENSE|LICENCE|COPYING|NOTICE)$")
    continue()
  endif()
  get_filename_component(parent "${relative}" DIRECTORY)
  file(MAKE_DIRECTORY "${UI_DESTINATION}/${parent}")
  file(COPY_FILE "${UI_SOURCE}/${relative}" "${UI_DESTINATION}/${relative}" ONLY_IF_DIFFERENT)
  list(APPEND staged_ui_files "${relative}")
  if(relative MATCHES "^music-(visualizers|background|effects|material)/")
    list(APPEND staged_visualizers "${relative}")
  endif()
endforeach()
string(JOIN "\n" ui_payload ${staged_ui_files})
file(WRITE "${UI_DESTINATION}/payload-manifest.txt" "${ui_payload}\n")
# Mode bundles have content-hashed chunks. Remove only obsolete staged music
# files so incremental builds cannot accumulate old runtimes or QA screenshots.
file(GLOB_RECURSE previous_visualizers RELATIVE "${UI_DESTINATION}" "${UI_DESTINATION}/music-visualizers/*" "${UI_DESTINATION}/music-background/*" "${UI_DESTINATION}/music-effects/*" "${UI_DESTINATION}/music-material/*")
foreach(relative IN LISTS previous_visualizers)
  if(NOT relative IN_LIST staged_visualizers)
    file(REMOVE "${UI_DESTINATION}/${relative}")
  endif()
endforeach()
