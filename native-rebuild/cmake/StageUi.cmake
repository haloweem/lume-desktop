cmake_policy(SET CMP0057 NEW)
cmake_path(ABSOLUTE_PATH UI_SOURCE NORMALIZE OUTPUT_VARIABLE ui_source_path)
cmake_path(ABSOLUTE_PATH UI_DESTINATION NORMALIZE OUTPUT_VARIABLE ui_destination_path)
cmake_path(IS_PREFIX ui_source_path "${ui_destination_path}" NORMALIZE destination_inside_source)
if(destination_inside_source)
  message(FATAL_ERROR "UI staging destination must be outside the source tree")
endif()
file(GLOB_RECURSE ui_files RELATIVE "${UI_SOURCE}" "${UI_SOURCE}/*")
set(staged_visualizers)
set(staged_ui_files)
# Browser evidence can be written under ui/ when tests run from that directory.
# Keep it out of both the live UI and its recovery copy, including old stages.
set(ui_development_directories "(^|/)(build-artifacts|test-results|playwright-report|coverage|\\.cache|verification|evidence|tests|tools|node_modules)(/|$)")
file(GLOB_RECURSE previous_ui_files RELATIVE "${UI_DESTINATION}" "${UI_DESTINATION}/*")
foreach(relative IN LISTS previous_ui_files)
  if(relative MATCHES "${ui_development_directories}")
    file(REMOVE "${UI_DESTINATION}/${relative}")
  endif()
endforeach()
# A former build-time extractor lived at this path; never ship it as page code.
file(REMOVE "${UI_DESTINATION}/extract-reference.mjs")
# Local browser mockup uses a development-only wallpaper route.
file(REMOVE "${UI_DESTINATION}/dynamic-island-preview.html")
# A deleted feature must not survive in incremental installers. A future
# implementation may reuse this filename once it exists in source again.
if(NOT EXISTS "${UI_SOURCE}/island-customization.js")
  file(REMOVE "${UI_DESTINATION}/island-customization.js")
endif()
foreach(relative IN LISTS ui_files)
  if(relative STREQUAL "dynamic-island-preview.html")
    continue()
  endif()
  if(relative MATCHES "${ui_development_directories}" OR relative MATCHES "\\.test\\.|^music-(visualizers|background|effects|material)/(.*/)?(source|src)/|^music-visualizers/reference/contracts\\.js$")
    continue()
  endif()
  if(NOT relative STREQUAL "assets/notifications/off-work-squidward.wav" AND NOT relative MATCHES "\\.(html|css|js|mjs|png|jpg|jpeg|svg|webp|ttf|otf|woff|woff2)$" AND NOT relative MATCHES "^assets/sources/.*\\.md$" AND NOT relative MATCHES "^assets/music/(SOURCES\\.md|lucide-LICENSE\\.txt)$" AND NOT relative MATCHES "^vendor/notes-(math|editor)/.*\\.(txt|md|json)$" AND NOT relative MATCHES "^music-(visualizers|background|effects|material|provider-qr)/.*\\.(txt|md|json)$" AND NOT relative MATCHES "^music-(visualizers|background|effects|material)/.*/licenses/.*(LICENSE|LICENCE|COPYING|NOTICE)$")
    continue()
  endif()
  get_filename_component(parent "${relative}" DIRECTORY)
  file(MAKE_DIRECTORY "${UI_DESTINATION}/${parent}")
  file(COPY_FILE "${UI_SOURCE}/${relative}" "${UI_DESTINATION}/${relative}" ONLY_IF_DIFFERENT)
  list(APPEND staged_ui_files "${relative}")
  if(relative MATCHES "^music-(visualizers|background|effects|material)/")
    list(APPEND staged_visualizers "${relative}")
  endif()
endforeach()
string(JOIN "\n" ui_payload ${staged_ui_files})
file(WRITE "${UI_DESTINATION}/payload-manifest.txt" "${ui_payload}\n")
if(DEFINED UI_INTEGRITY_HEADER)
  set(integrity_rows "")
  foreach(relative IN LISTS staged_ui_files)
    file(SHA256 "${UI_DESTINATION}/${relative}" digest)
    file(SIZE "${UI_DESTINATION}/${relative}" bytes)
    string(APPEND integrity_rows "    {L\"${relative}\", ${bytes}ULL, \"${digest}\"},\n")
  endforeach()
  string(SHA256 integrity_id "${integrity_rows}")
  get_filename_component(integrity_directory "${UI_INTEGRITY_HEADER}" DIRECTORY)
  file(MAKE_DIRECTORY "${integrity_directory}")
  file(WRITE "${UI_INTEGRITY_HEADER}.tmp" "// Generated from the exact staged UI; never read hashes from the installation.\ninline constexpr char UiIntegrityId[] = \"${integrity_id}\";\ninline const std::vector<UiIntegrityEntry> UiIntegrityEntries{\n${integrity_rows}};\n")
  file(COPY_FILE "${UI_INTEGRITY_HEADER}.tmp" "${UI_INTEGRITY_HEADER}" ONLY_IF_DIFFERENT)
endif()
# Mode bundles have content-hashed chunks. Remove only obsolete staged music
# files so incremental builds cannot accumulate old runtimes or QA screenshots.
file(GLOB_RECURSE previous_visualizers RELATIVE "${UI_DESTINATION}" "${UI_DESTINATION}/music-visualizers/*" "${UI_DESTINATION}/music-background/*" "${UI_DESTINATION}/music-effects/*" "${UI_DESTINATION}/music-material/*")
foreach(relative IN LISTS previous_visualizers)
  if(NOT relative IN_LIST staged_visualizers)
    file(REMOVE "${UI_DESTINATION}/${relative}")
  endif()
endforeach()
