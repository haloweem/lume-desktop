foreach(kind controller store runtime session payload port visibility)
  set(target "lume-taskbar-${kind}-test")
  add_executable(${target} "taskbar_${kind}_test.cpp")
  target_compile_definitions(${target} PRIVATE UNICODE _UNICODE WIN32_LEAN_AND_MEAN NOMINMAX _WIN32_WINNT=0x0A00 WINVER=0x0A00)
  if(kind STREQUAL "controller" OR kind STREQUAL "store")
    target_link_libraries(${target} PRIVATE lume-taskbar-core)
  elseif(kind STREQUAL "session")
    target_link_libraries(${target} PRIVATE lume-taskbar-session psapi)
  else()
    target_link_libraries(${target} PRIVATE lume-taskbar-windows psapi)
  endif()
  if(MINGW)
    target_link_options(${target} PRIVATE -static)
  endif()
  lume_enable_native_warnings(${target})
  add_test(NAME ${target} COMMAND ${target})
  set_tests_properties(${target} PROPERTIES RUN_SERIAL TRUE TIMEOUT 60)
endforeach()
