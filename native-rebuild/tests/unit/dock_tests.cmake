foreach(name model window reflection)
  add_executable(lume-dock-${name}-test dock_${name}_test.cpp)
  target_compile_definitions(lume-dock-${name}-test PRIVATE UNICODE _UNICODE WIN32_LEAN_AND_MEAN NOMINMAX _WIN32_WINNT=0x0A00 WINVER=0x0A00)
  target_link_libraries(lume-dock-${name}-test PRIVATE lume-dock-runtime ole32)
  set_target_properties(lume-dock-${name}-test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
  lume_enable_native_warnings(lume-dock-${name}-test)
  add_test(NAME lume-dock-${name}-test COMMAND lume-dock-${name}-test)
  set_tests_properties(lume-dock-${name}-test PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE)
endforeach()
