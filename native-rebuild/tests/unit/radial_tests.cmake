foreach(name model render image editor)
  add_executable(lume-screenshot-${name}-test screenshot_${name}_test.cpp)
  target_compile_definitions(lume-screenshot-${name}-test PRIVATE UNICODE _UNICODE WIN32_LEAN_AND_MEAN NOMINMAX _WIN32_WINNT=0x0A00 WINVER=0x0A00)
  target_link_libraries(lume-screenshot-${name}-test PRIVATE lume-screenshot)
  set_target_properties(lume-screenshot-${name}-test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
  lume_enable_native_warnings(lume-screenshot-${name}-test)
  add_test(NAME lume-screenshot-${name}-test COMMAND lume-screenshot-${name}-test)
  set_tests_properties(lume-screenshot-${name}-test PROPERTIES TIMEOUT 45 RUN_SERIAL TRUE)
endforeach()
foreach(name menu shortcut window session page_protocol context_menu annular_region)
  add_executable(lume-radial-${name}-test radial_${name}_test.cpp)
  target_compile_definitions(lume-radial-${name}-test PRIVATE UNICODE _UNICODE WIN32_LEAN_AND_MEAN NOMINMAX _WIN32_WINNT=0x0A00 WINVER=0x0A00)
  target_link_libraries(lume-radial-${name}-test PRIVATE lume-radial-session ole32)
  set_target_properties(lume-radial-${name}-test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
  if(MINGW)
    target_link_options(lume-radial-${name}-test PRIVATE -static)
  endif()
  lume_enable_native_warnings(lume-radial-${name}-test)
  add_test(NAME lume-radial-${name}-test COMMAND lume-radial-${name}-test)
  set_tests_properties(lume-radial-${name}-test PROPERTIES TIMEOUT 30 RUN_SERIAL TRUE)
endforeach()
add_dependencies(lume-radial-window-test lume-material-dll)
add_dependencies(lume-radial-session-test lume-material-dll)
add_executable(lume-radial-preview EXCLUDE_FROM_ALL radial_preview.cpp)
target_compile_definitions(lume-radial-preview PRIVATE UNICODE _UNICODE WIN32_LEAN_AND_MEAN NOMINMAX _WIN32_WINNT=0x0A00 WINVER=0x0A00)
target_link_libraries(lume-radial-preview PRIVATE lume-radial-runtime ole32 dwmapi)
set_target_properties(lume-radial-preview PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
lume_enable_native_warnings(lume-radial-preview)
add_dependencies(lume-radial-preview lume-material-dll)
