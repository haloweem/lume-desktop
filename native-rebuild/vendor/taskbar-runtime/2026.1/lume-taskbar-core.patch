+void TaskbarAppearanceService::StopWatchingFill(const std::shared_ptr<BackgroundState>& state) noexcept
+{
+	if (const auto token = std::exchange(state->fillToken, std::nullopt); token && state->control)
+	{
+		try { state->control.UnregisterPropertyChangedCallback(wux::Shapes::Shape::FillProperty(), *token); }
+		catch (...) { } // A stale notification is guarded by active/originalFill and weak ownership.
+	}
+}
+
+void TaskbarAppearanceService::CancelBackground(const std::shared_ptr<BackgroundState>& state) noexcept
+{
+	state->active = false;
+	state->requested.reset();
+	++state->revision;
+	StopWatchingFill(state);
+}
+
+void TaskbarAppearanceService::TryApplyBackground(const std::shared_ptr<BackgroundState>& state)
+{
+	if (!state->active || !state->control) return;
+	if (!state->originalFill)
+	{
+		auto original = state->control.Fill();
+		if (!state->active || !original) return;
+		state->originalFill = std::move(original);
+		StopWatchingFill(state);
+	}
+	if (!state->active || !state->requested) return;
+	const auto request = *state->requested;
+	const auto revision = state->revision;
+	auto brush = CreateBackgroundBrush(state->control, request);
+	if (state->active && state->requested && state->revision == revision) state->control.Fill(brush);
+}
+
+void TaskbarAppearanceService::WatchBackgroundFill(const std::shared_ptr<BackgroundState>& state)
+{
+	if (!state->active || !state->control || state->originalFill || state->fillToken) return;
+	const auto weakSelf = get_weak();
+	const std::weak_ptr<BackgroundState> weakState = state;
+	auto control = state->control;
+	const auto token = control.RegisterPropertyChangedCallback(wux::Shapes::Shape::FillProperty(),
+		[weakSelf, weakState](auto&&, auto&&) noexcept
+		{
+			try
+			{
+				if (const auto self = weakSelf.get())
+					if (const auto current = weakState.lock(); current && current->active && !current->originalFill)
+						self->TryApplyBackground(current);
+			}
+			catch (...) { } // Do not let deferred initialization throw into Explorer.
+		});
+	// Registration may reenter; do not attach a token to a retired or already captured state.
+	if (state->active && !state->originalFill) state->fillToken = token;
+	else
+	{
+		try { control.UnregisterPropertyChangedCallback(wux::Shapes::Shape::FillProperty(), token); }
+		catch (...) { }
+	}
+	TryApplyBackground(state); // Reading after subscription closes the initialization race.
+}
+
+wux::Media::Brush TaskbarAppearanceService::CreateBackgroundBrush(const wux::Shapes::Shape& control, const AppearanceRequest& request)
+{
+	const winrt::Windows::UI::Color tint = Util::Color::FromABGR(request.color);
+	if (request.blurAmount)
+	{
+		const wfn::float4 tintHdr = { tint.R / 255.0f, tint.G / 255.0f, tint.B / 255.0f, tint.A / 255.0f };
+		auto compositor = wuxh::ElementCompositionPreview::GetElementVisual(control).Compositor();
+		return winrt::make<XamlBlurBrush>(std::move(compositor), *request.blurAmount, tintHdr);
+	}
+	if (request.brush == Acrylic)
+	{
+		wux::Media::AcrylicBrush brush;
+		// Backdrop retains the effect while the transparent taskbar window is inactive.
+		brush.BackgroundSource(wux::Media::AcrylicBackgroundSource::Backdrop);
+		brush.TintColor(tint);
+		return brush;
+	}
+	if (request.brush == SolidColor)
+	{
+		wux::Media::SolidColorBrush brush;
+		brush.Color(tint);
+		return brush;
+	}
+	return nullptr;
+}
